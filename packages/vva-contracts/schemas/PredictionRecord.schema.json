{
  "$defs": {
    "Detection": {
      "additionalProperties": false,
      "description": "One detector output after NMS.",
      "properties": {
        "class_name": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Class Name",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "bbox_xyxy": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Bbox Xyxy",
          "type": "array"
        }
      },
      "required": [
        "class_name",
        "confidence",
        "bbox_xyxy"
      ],
      "title": "Detection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Detector output for one dataset image (input of DETECTION_EVAL).\n\n``image_id`` is the image path relative to ``images/<split>/`` without the\nfile extension, using ``/`` as separator, e.g. ``cam1/2026-10-01_000123``.",
  "properties": {
    "width": {
      "exclusiveMinimum": 0,
      "maximum": 16384,
      "title": "Width",
      "type": "integer"
    },
    "height": {
      "exclusiveMinimum": 0,
      "maximum": 16384,
      "title": "Height",
      "type": "integer"
    },
    "detections": {
      "items": {
        "$ref": "#/$defs/Detection"
      },
      "maxItems": 1000,
      "title": "Detections",
      "type": "array"
    },
    "image_id": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Image Id",
      "type": "string"
    }
  },
  "required": [
    "width",
    "height",
    "detections",
    "image_id"
  ],
  "title": "PredictionRecord",
  "type": "object"
}
