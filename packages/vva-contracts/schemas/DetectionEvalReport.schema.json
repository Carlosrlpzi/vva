{
  "$defs": {
    "ClassEval": {
      "additionalProperties": false,
      "properties": {
        "class_name": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Class Name",
          "type": "string"
        },
        "n_gt": {
          "minimum": 0,
          "title": "N Gt",
          "type": "integer"
        },
        "n_pred": {
          "minimum": 0,
          "title": "N Pred",
          "type": "integer"
        },
        "ap50": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ap50"
        },
        "ap50_95": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ap50 95"
        },
        "ap_per_iou": {
          "anyOf": [
            {
              "items": {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ap Per Iou"
        },
        "pr_curve_ap50": {
          "anyOf": [
            {
              "items": {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pr Curve Ap50"
        },
        "operating_point": {
          "$ref": "#/$defs/OperatingPoint"
        }
      },
      "required": [
        "class_name",
        "n_gt",
        "n_pred",
        "ap50",
        "ap50_95",
        "ap_per_iou",
        "pr_curve_ap50",
        "operating_point"
      ],
      "title": "ClassEval",
      "type": "object"
    },
    "InputFingerprint": {
      "additionalProperties": false,
      "description": "Which exact bytes produced a report: the audit trail of every input.\n\nIf someone later asks \"was this mAP computed on the current predictions\nfile?\", the answer is a hash comparison, not a recollection.",
      "properties": {
        "role": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "role",
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "InputFingerprint",
      "type": "object"
    },
    "OperatingPoint": {
      "additionalProperties": false,
      "description": "Counts at the confidence threshold the alert rules will actually use (IoU 0.5).",
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "tp": {
          "minimum": 0,
          "title": "Tp",
          "type": "integer"
        },
        "fp": {
          "minimum": 0,
          "title": "Fp",
          "type": "integer"
        },
        "fn": {
          "minimum": 0,
          "title": "Fn",
          "type": "integer"
        },
        "precision": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Precision"
        },
        "recall": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Recall"
        },
        "f1": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "F1"
        }
      },
      "required": [
        "confidence",
        "tp",
        "fp",
        "fn",
        "precision",
        "recall",
        "f1"
      ],
      "title": "OperatingPoint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_id": {
      "const": "DetectionEvalReport",
      "default": "DetectionEvalReport",
      "title": "Contract Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tool_version": {
      "title": "Tool Version",
      "type": "string"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/InputFingerprint"
      },
      "title": "Inputs",
      "type": "array"
    },
    "split": {
      "maxLength": 32,
      "minLength": 1,
      "title": "Split",
      "type": "string"
    },
    "iou_thresholds": {
      "items": {
        "type": "number"
      },
      "maxItems": 10,
      "minItems": 10,
      "title": "Iou Thresholds",
      "type": "array"
    },
    "max_detections_per_image": {
      "minimum": 1,
      "title": "Max Detections Per Image",
      "type": "integer"
    },
    "n_images": {
      "minimum": 1,
      "title": "N Images",
      "type": "integer"
    },
    "n_images_without_predictions": {
      "minimum": 0,
      "title": "N Images Without Predictions",
      "type": "integer"
    },
    "n_predictions_other_classes": {
      "minimum": 0,
      "title": "N Predictions Other Classes",
      "type": "integer"
    },
    "per_class": {
      "items": {
        "$ref": "#/$defs/ClassEval"
      },
      "minItems": 1,
      "title": "Per Class",
      "type": "array"
    },
    "map50": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Map50"
    },
    "map50_95": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Map50 95"
    }
  },
  "required": [
    "tool_version",
    "inputs",
    "split",
    "iou_thresholds",
    "max_detections_per_image",
    "n_images",
    "n_images_without_predictions",
    "n_predictions_other_classes",
    "per_class",
    "map50",
    "map50_95"
  ],
  "title": "DetectionEvalReport",
  "type": "object"
}
