{
  "$defs": {
    "ClassBoxSize": {
      "additionalProperties": false,
      "description": "Pixel height of boxes when the image is resized to the inference size.",
      "properties": {
        "class_name": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Class Name",
          "type": "string"
        },
        "n_boxes": {
          "minimum": 1,
          "title": "N Boxes",
          "type": "integer"
        },
        "height_px_p05": {
          "minimum": 0.0,
          "title": "Height Px P05",
          "type": "number"
        },
        "height_px_p50": {
          "minimum": 0.0,
          "title": "Height Px P50",
          "type": "number"
        },
        "height_px_p95": {
          "minimum": 0.0,
          "title": "Height Px P95",
          "type": "number"
        },
        "share_below_min_px": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Share Below Min Px",
          "type": "number"
        }
      },
      "required": [
        "class_name",
        "n_boxes",
        "height_px_p05",
        "height_px_p50",
        "height_px_p95",
        "share_below_min_px"
      ],
      "title": "ClassBoxSize",
      "type": "object"
    },
    "GroupLeakageCheck": {
      "additionalProperties": false,
      "properties": {
        "checked": {
          "title": "Checked",
          "type": "boolean"
        },
        "reason_unchecked": {
          "anyOf": [
            {
              "maxLength": 280,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason Unchecked"
        },
        "n_groups": {
          "minimum": 0,
          "title": "N Groups",
          "type": "integer"
        },
        "n_images_unmatched": {
          "minimum": 0,
          "title": "N Images Unmatched",
          "type": "integer"
        },
        "groups_in_multiple_splits": {
          "items": {
            "type": "string"
          },
          "maxItems": 200,
          "title": "Groups In Multiple Splits",
          "type": "array"
        }
      },
      "required": [
        "checked",
        "reason_unchecked",
        "n_groups",
        "n_images_unmatched",
        "groups_in_multiple_splits"
      ],
      "title": "GroupLeakageCheck",
      "type": "object"
    },
    "InputFingerprint": {
      "additionalProperties": false,
      "description": "Which exact bytes produced a report: the audit trail of every input.\n\nIf someone later asks \"was this mAP computed on the current predictions\nfile?\", the answer is a hash comparison, not a recollection.",
      "properties": {
        "role": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "role",
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "InputFingerprint",
      "type": "object"
    },
    "LabelIssue": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "File",
          "type": "string"
        },
        "line": {
          "minimum": 1,
          "title": "Line",
          "type": "integer"
        },
        "code": {
          "enum": [
            "malformed_line",
            "class_out_of_range",
            "coord_out_of_range",
            "non_positive_size",
            "box_outside_image"
          ],
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "maxLength": 280,
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "file",
        "line",
        "code",
        "detail"
      ],
      "title": "LabelIssue",
      "type": "object"
    },
    "NearDuplicateCheck": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "const": "dhash64_banded",
          "default": "dhash64_banded",
          "title": "Method",
          "type": "string"
        },
        "n_bands": {
          "const": 8,
          "default": 8,
          "title": "N Bands",
          "type": "integer"
        },
        "hamming_threshold": {
          "maximum": 7,
          "minimum": 0,
          "title": "Hamming Threshold",
          "type": "integer"
        },
        "reference_split": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Reference Split",
          "type": "string"
        },
        "images_with_match_in_reference": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Images With Match In Reference",
          "type": "object"
        },
        "examples": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "maxItems": 50,
          "title": "Examples",
          "type": "array"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "hamming_threshold",
        "reference_split",
        "images_with_match_in_reference",
        "examples",
        "truncated"
      ],
      "title": "NearDuplicateCheck",
      "type": "object"
    },
    "SplitStats": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "n_images": {
          "minimum": 0,
          "title": "N Images",
          "type": "integer"
        },
        "n_background_images": {
          "minimum": 0,
          "title": "N Background Images",
          "type": "integer"
        },
        "n_boxes": {
          "minimum": 0,
          "title": "N Boxes",
          "type": "integer"
        },
        "boxes_per_class": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "maxLength": 64,
            "minLength": 1
          },
          "title": "Boxes Per Class",
          "type": "object"
        },
        "box_sizes": {
          "items": {
            "$ref": "#/$defs/ClassBoxSize"
          },
          "title": "Box Sizes",
          "type": "array"
        },
        "n_exact_duplicate_images": {
          "minimum": 0,
          "title": "N Exact Duplicate Images",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "manifest_sha256",
        "n_images",
        "n_background_images",
        "n_boxes",
        "boxes_per_class",
        "box_sizes",
        "n_exact_duplicate_images"
      ],
      "title": "SplitStats",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_id": {
      "const": "DatasetAuditReport",
      "default": "DatasetAuditReport",
      "title": "Contract Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tool_version": {
      "title": "Tool Version",
      "type": "string"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/InputFingerprint"
      },
      "title": "Inputs",
      "type": "array"
    },
    "class_names": {
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Class Names",
      "type": "array"
    },
    "inference_size": {
      "items": {
        "type": "integer"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Inference Size",
      "type": "array"
    },
    "min_box_px": {
      "minimum": 2,
      "title": "Min Box Px",
      "type": "integer"
    },
    "splits": {
      "items": {
        "$ref": "#/$defs/SplitStats"
      },
      "minItems": 1,
      "title": "Splits",
      "type": "array"
    },
    "n_label_issues": {
      "minimum": 0,
      "title": "N Label Issues",
      "type": "integer"
    },
    "label_issues": {
      "items": {
        "$ref": "#/$defs/LabelIssue"
      },
      "maxItems": 200,
      "title": "Label Issues",
      "type": "array"
    },
    "n_orphan_labels": {
      "minimum": 0,
      "title": "N Orphan Labels",
      "type": "integer"
    },
    "near_duplicates": {
      "$ref": "#/$defs/NearDuplicateCheck"
    },
    "group_leakage": {
      "$ref": "#/$defs/GroupLeakageCheck"
    },
    "risk_flags": {
      "items": {
        "enum": [
          "LABEL_ERRORS",
          "ORPHAN_LABELS",
          "CROSS_SPLIT_NEAR_DUPLICATES",
          "GROUP_LEAKAGE",
          "GROUP_LEAKAGE_UNCHECKED",
          "GROUP_REGEX_PARTIAL_MATCH",
          "NEAR_DUPLICATE_SEARCH_TRUNCATED",
          "SMALL_BOXES",
          "CLASS_MISSING_IN_SPLIT"
        ],
        "type": "string"
      },
      "title": "Risk Flags",
      "type": "array"
    },
    "verdict": {
      "enum": [
        "PASS",
        "WARN",
        "FAIL"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "required": [
    "tool_version",
    "inputs",
    "class_names",
    "inference_size",
    "min_box_px",
    "splits",
    "n_label_issues",
    "label_issues",
    "n_orphan_labels",
    "near_duplicates",
    "group_leakage",
    "risk_flags",
    "verdict"
  ],
  "title": "DatasetAuditReport",
  "type": "object"
}
