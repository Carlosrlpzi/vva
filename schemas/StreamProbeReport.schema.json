{
  "$defs": {
    "InputFingerprint": {
      "additionalProperties": false,
      "description": "Provenance of one input: which file, in which role, with which bytes.",
      "properties": {
        "role": {
          "pattern": "^[A-Za-z0-9_.-]{1,64}$",
          "title": "Role",
          "type": "string"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "role",
        "path",
        "sha256"
      ],
      "title": "InputFingerprint",
      "type": "object"
    },
    "ReportMeta": {
      "additionalProperties": false,
      "description": "Header present in every report (who produced it, from what, when).",
      "properties": {
        "tool_version": {
          "title": "Tool Version",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/InputFingerprint"
          },
          "title": "Inputs",
          "type": "array"
        }
      },
      "required": [
        "tool_version",
        "generated_at",
        "inputs"
      ],
      "title": "ReportMeta",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Accepted STREAM_PROBE artifact. Never contains the stream URL.",
  "properties": {
    "contract_id": {
      "const": "StreamProbeReport",
      "default": "StreamProbeReport",
      "title": "Contract Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "meta": {
      "$ref": "#/$defs/ReportMeta"
    },
    "camera_id": {
      "pattern": "^[A-Za-z0-9_.-]{1,64}$",
      "title": "Camera Id",
      "type": "string"
    },
    "source_kind": {
      "enum": [
        "rtsp",
        "file"
      ],
      "title": "Source Kind",
      "type": "string"
    },
    "source_ref": {
      "title": "Source Ref",
      "type": "string"
    },
    "codec": {
      "title": "Codec",
      "type": "string"
    },
    "profile": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Profile"
    },
    "width": {
      "minimum": 1,
      "title": "Width",
      "type": "integer"
    },
    "height": {
      "minimum": 1,
      "title": "Height",
      "type": "integer"
    },
    "pix_fmt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Pix Fmt"
    },
    "declared_fps": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Declared Fps"
    },
    "requested_duration_s": {
      "minimum": 0.0,
      "title": "Requested Duration S",
      "type": "number"
    },
    "n_packets": {
      "minimum": 2,
      "title": "N Packets",
      "type": "integer"
    },
    "n_keyframes": {
      "minimum": 0,
      "title": "N Keyframes",
      "type": "integer"
    },
    "measured_duration_s": {
      "exclusiveMinimum": 0.0,
      "title": "Measured Duration S",
      "type": "number"
    },
    "measured_fps": {
      "exclusiveMinimum": 0.0,
      "title": "Measured Fps",
      "type": "number"
    },
    "fps_ratio": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Fps Ratio"
    },
    "keyframe_interval_frames": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Keyframe Interval Frames"
    },
    "interval_jitter_ms": {
      "minimum": 0.0,
      "title": "Interval Jitter Ms",
      "type": "number"
    },
    "n_gaps": {
      "minimum": 0,
      "title": "N Gaps",
      "type": "integer"
    },
    "min_fps_ratio": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Min Fps Ratio",
      "type": "number"
    },
    "flags": {
      "items": {
        "enum": [
          "fps_below_declared",
          "declared_fps_unknown",
          "no_keyframes",
          "timestamp_gaps"
        ],
        "type": "string"
      },
      "title": "Flags",
      "type": "array"
    }
  },
  "required": [
    "meta",
    "camera_id",
    "source_kind",
    "source_ref",
    "codec",
    "profile",
    "width",
    "height",
    "pix_fmt",
    "declared_fps",
    "requested_duration_s",
    "n_packets",
    "n_keyframes",
    "measured_duration_s",
    "measured_fps",
    "fps_ratio",
    "keyframe_interval_frames",
    "interval_jitter_ms",
    "n_gaps",
    "min_fps_ratio",
    "flags"
  ],
  "title": "StreamProbeReport",
  "type": "object"
}
