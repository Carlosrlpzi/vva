{
  "$defs": {
    "ClassMetrics": {
      "additionalProperties": false,
      "description": "Measured metrics for one class.",
      "properties": {
        "class_id": {
          "minimum": 0,
          "title": "Class Id",
          "type": "integer"
        },
        "class_name": {
          "title": "Class Name",
          "type": "string"
        },
        "n_gt": {
          "minimum": 0,
          "title": "N Gt",
          "type": "integer"
        },
        "n_pred": {
          "minimum": 0,
          "title": "N Pred",
          "type": "integer"
        },
        "ap_per_iou": {
          "anyOf": [
            {
              "items": {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ap Per Iou"
        },
        "ap50": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ap50"
        },
        "ap50_95": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ap50 95"
        },
        "tp": {
          "minimum": 0,
          "title": "Tp",
          "type": "integer"
        },
        "fp": {
          "minimum": 0,
          "title": "Fp",
          "type": "integer"
        },
        "fn": {
          "minimum": 0,
          "title": "Fn",
          "type": "integer"
        },
        "precision": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Precision",
          "type": "number"
        },
        "recall": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Recall",
          "type": "number"
        },
        "f1": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "F1",
          "type": "number"
        }
      },
      "required": [
        "class_id",
        "class_name",
        "n_gt",
        "n_pred",
        "ap_per_iou",
        "ap50",
        "ap50_95",
        "tp",
        "fp",
        "fn",
        "precision",
        "recall",
        "f1"
      ],
      "title": "ClassMetrics",
      "type": "object"
    },
    "DetectionMetrics": {
      "additionalProperties": false,
      "description": "All metrics of one predictions file against one split.",
      "properties": {
        "operating_confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Operating Confidence",
          "type": "number"
        },
        "max_dets_per_image": {
          "minimum": 1,
          "title": "Max Dets Per Image",
          "type": "integer"
        },
        "iou_thresholds": {
          "items": {
            "type": "number"
          },
          "title": "Iou Thresholds",
          "type": "array"
        },
        "n_images": {
          "minimum": 0,
          "title": "N Images",
          "type": "integer"
        },
        "n_prediction_rows": {
          "minimum": 0,
          "title": "N Prediction Rows",
          "type": "integer"
        },
        "classes": {
          "items": {
            "$ref": "#/$defs/ClassMetrics"
          },
          "minItems": 1,
          "title": "Classes",
          "type": "array"
        },
        "map50": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Map50"
        },
        "map50_95": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Map50 95"
        }
      },
      "required": [
        "operating_confidence",
        "max_dets_per_image",
        "iou_thresholds",
        "n_images",
        "n_prediction_rows",
        "classes",
        "map50",
        "map50_95"
      ],
      "title": "DetectionMetrics",
      "type": "object"
    },
    "InputFingerprint": {
      "additionalProperties": false,
      "description": "Provenance of one input: which file, in which role, with which bytes.",
      "properties": {
        "role": {
          "pattern": "^[A-Za-z0-9_.-]{1,64}$",
          "title": "Role",
          "type": "string"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "role",
        "path",
        "sha256"
      ],
      "title": "InputFingerprint",
      "type": "object"
    },
    "ReportMeta": {
      "additionalProperties": false,
      "description": "Header present in every report (who produced it, from what, when).",
      "properties": {
        "tool_version": {
          "title": "Tool Version",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/InputFingerprint"
          },
          "title": "Inputs",
          "type": "array"
        }
      },
      "required": [
        "tool_version",
        "generated_at",
        "inputs"
      ],
      "title": "ReportMeta",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Accepted DETECTION_EVAL artifact.",
  "properties": {
    "contract_id": {
      "const": "DetectionEvalReport",
      "default": "DetectionEvalReport",
      "title": "Contract Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "meta": {
      "$ref": "#/$defs/ReportMeta"
    },
    "split": {
      "pattern": "^[A-Za-z0-9_.-]{1,64}$",
      "title": "Split",
      "type": "string"
    },
    "box_format": {
      "enum": [
        "xyxyn",
        "xywhn"
      ],
      "title": "Box Format",
      "type": "string"
    },
    "metrics": {
      "$ref": "#/$defs/DetectionMetrics"
    }
  },
  "required": [
    "meta",
    "split",
    "box_format",
    "metrics"
  ],
  "title": "DetectionEvalReport",
  "type": "object"
}
