{
  "$defs": {
    "AlertRecord": {
      "additionalProperties": false,
      "description": "One alert the policy would have fired, with its trigger evidence.",
      "properties": {
        "camera_id": {
          "pattern": "^[A-Za-z0-9_.-]{1,64}$",
          "title": "Camera Id",
          "type": "string"
        },
        "frame_idx": {
          "minimum": 0,
          "title": "Frame Idx",
          "type": "integer"
        },
        "ts": {
          "minimum": 0.0,
          "title": "Ts",
          "type": "number"
        },
        "streak": {
          "minimum": 1,
          "title": "Streak",
          "type": "integer"
        },
        "max_confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Max Confidence",
          "type": "number"
        },
        "matched_event_line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Matched Event Line"
        }
      },
      "required": [
        "camera_id",
        "frame_idx",
        "ts",
        "streak",
        "max_confidence",
        "matched_event_line"
      ],
      "title": "AlertRecord",
      "type": "object"
    },
    "CameraStats": {
      "additionalProperties": false,
      "description": "Alert load on one camera.",
      "properties": {
        "camera_id": {
          "pattern": "^[A-Za-z0-9_.-]{1,64}$",
          "title": "Camera Id",
          "type": "string"
        },
        "n_frames": {
          "minimum": 0,
          "title": "N Frames",
          "type": "integer"
        },
        "observed_hours": {
          "minimum": 0.0,
          "title": "Observed Hours",
          "type": "number"
        },
        "n_alerts": {
          "minimum": 0,
          "title": "N Alerts",
          "type": "integer"
        },
        "alerts_per_hour": {
          "minimum": 0.0,
          "title": "Alerts Per Hour",
          "type": "number"
        }
      },
      "required": [
        "camera_id",
        "n_frames",
        "observed_hours",
        "n_alerts",
        "alerts_per_hour"
      ],
      "title": "CameraStats",
      "type": "object"
    },
    "EventOutcome": {
      "additionalProperties": false,
      "description": "How the policy performed against labelled events.",
      "properties": {
        "n_events": {
          "minimum": 0,
          "title": "N Events",
          "type": "integer"
        },
        "n_detected": {
          "minimum": 0,
          "title": "N Detected",
          "type": "integer"
        },
        "recall": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Recall",
          "type": "number"
        },
        "n_alerts_in_events": {
          "minimum": 0,
          "title": "N Alerts In Events",
          "type": "integer"
        },
        "alert_precision": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Alert Precision",
          "type": "number"
        },
        "latency_mean_s": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latency Mean S"
        },
        "latency_p50_s": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latency P50 S"
        },
        "latency_max_s": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latency Max S"
        }
      },
      "required": [
        "n_events",
        "n_detected",
        "recall",
        "n_alerts_in_events",
        "alert_precision",
        "latency_mean_s",
        "latency_p50_s",
        "latency_max_s"
      ],
      "title": "EventOutcome",
      "type": "object"
    },
    "InputFingerprint": {
      "additionalProperties": false,
      "description": "Provenance of one input: which file, in which role, with which bytes.",
      "properties": {
        "role": {
          "pattern": "^[A-Za-z0-9_.-]{1,64}$",
          "title": "Role",
          "type": "string"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "role",
        "path",
        "sha256"
      ],
      "title": "InputFingerprint",
      "type": "object"
    },
    "PolicyResult": {
      "additionalProperties": false,
      "description": "Replay outcome of one policy over every camera in the log.",
      "properties": {
        "policy": {
          "$ref": "#/$defs/PolicySpec"
        },
        "n_frames": {
          "minimum": 0,
          "title": "N Frames",
          "type": "integer"
        },
        "observed_hours": {
          "minimum": 0.0,
          "title": "Observed Hours",
          "type": "number"
        },
        "n_alerts": {
          "minimum": 0,
          "title": "N Alerts",
          "type": "integer"
        },
        "alerts_per_hour": {
          "minimum": 0.0,
          "title": "Alerts Per Hour",
          "type": "number"
        },
        "per_camera": {
          "items": {
            "$ref": "#/$defs/CameraStats"
          },
          "minItems": 1,
          "title": "Per Camera",
          "type": "array"
        },
        "ground_truth": {
          "anyOf": [
            {
              "$ref": "#/$defs/EventOutcome"
            },
            {
              "type": "null"
            }
          ]
        },
        "alerts": {
          "items": {
            "$ref": "#/$defs/AlertRecord"
          },
          "title": "Alerts",
          "type": "array"
        },
        "alerts_truncated": {
          "title": "Alerts Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "policy",
        "n_frames",
        "observed_hours",
        "n_alerts",
        "alerts_per_hour",
        "per_camera",
        "ground_truth",
        "alerts",
        "alerts_truncated"
      ],
      "title": "PolicyResult",
      "type": "object"
    },
    "PolicySpec": {
      "additionalProperties": false,
      "description": "One candidate alert policy to replay (mirrors core.state_machine.EventRule).",
      "properties": {
        "name": {
          "pattern": "^[A-Za-z0-9_.-]{1,64}$",
          "title": "Name",
          "type": "string"
        },
        "classes": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Classes",
          "type": "array"
        },
        "min_confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Min Confidence",
          "type": "number"
        },
        "min_consecutive_frames": {
          "maximum": 100,
          "minimum": 1,
          "title": "Min Consecutive Frames",
          "type": "integer"
        },
        "cooldown_s": {
          "maximum": 86400.0,
          "minimum": 0.0,
          "title": "Cooldown S",
          "type": "number"
        },
        "max_gap_s": {
          "exclusiveMinimum": 0.0,
          "maximum": 3600.0,
          "title": "Max Gap S",
          "type": "number"
        },
        "zones": {
          "patternProperties": {
            "^[A-Za-z0-9_.-]{1,64}$": {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "type": "number"
                  },
                  {
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              "type": "array"
            }
          },
          "title": "Zones",
          "type": "object"
        }
      },
      "required": [
        "name",
        "classes",
        "min_confidence",
        "min_consecutive_frames",
        "cooldown_s",
        "max_gap_s"
      ],
      "title": "PolicySpec",
      "type": "object"
    },
    "ReportMeta": {
      "additionalProperties": false,
      "description": "Header present in every report (who produced it, from what, when).",
      "properties": {
        "tool_version": {
          "title": "Tool Version",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/InputFingerprint"
          },
          "title": "Inputs",
          "type": "array"
        }
      },
      "required": [
        "tool_version",
        "generated_at",
        "inputs"
      ],
      "title": "ReportMeta",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Accepted RULE_REPLAY artifact.",
  "properties": {
    "contract_id": {
      "const": "RuleReplayReport",
      "default": "RuleReplayReport",
      "title": "Contract Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "meta": {
      "$ref": "#/$defs/ReportMeta"
    },
    "alert_grace_s": {
      "minimum": 0.0,
      "title": "Alert Grace S",
      "type": "number"
    },
    "camera_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9_.-]{1,64}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Camera Ids",
      "type": "array"
    },
    "policies": {
      "items": {
        "$ref": "#/$defs/PolicyResult"
      },
      "minItems": 1,
      "title": "Policies",
      "type": "array"
    }
  },
  "required": [
    "meta",
    "alert_grace_s",
    "camera_ids",
    "policies"
  ],
  "title": "RuleReplayReport",
  "type": "object"
}
