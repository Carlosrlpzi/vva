{
  "$defs": {
    "InputFingerprint": {
      "additionalProperties": false,
      "description": "Provenance of one input: which file, in which role, with which bytes.",
      "properties": {
        "role": {
          "pattern": "^[A-Za-z0-9_.-]{1,64}$",
          "title": "Role",
          "type": "string"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "role",
        "path",
        "sha256"
      ],
      "title": "InputFingerprint",
      "type": "object"
    },
    "LatencySummary": {
      "additionalProperties": false,
      "description": "Distribution of one latency (milliseconds).",
      "properties": {
        "n": {
          "minimum": 1,
          "title": "N",
          "type": "integer"
        },
        "mean_ms": {
          "minimum": 0.0,
          "title": "Mean Ms",
          "type": "number"
        },
        "p50_ms": {
          "minimum": 0.0,
          "title": "P50 Ms",
          "type": "number"
        },
        "p95_ms": {
          "minimum": 0.0,
          "title": "P95 Ms",
          "type": "number"
        },
        "p99_ms": {
          "minimum": 0.0,
          "title": "P99 Ms",
          "type": "number"
        },
        "max_ms": {
          "minimum": 0.0,
          "title": "Max Ms",
          "type": "number"
        }
      },
      "required": [
        "n",
        "mean_ms",
        "p50_ms",
        "p95_ms",
        "p99_ms",
        "max_ms"
      ],
      "title": "LatencySummary",
      "type": "object"
    },
    "ReportMeta": {
      "additionalProperties": false,
      "description": "Header present in every report (who produced it, from what, when).",
      "properties": {
        "tool_version": {
          "title": "Tool Version",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/InputFingerprint"
          },
          "title": "Inputs",
          "type": "array"
        }
      },
      "required": [
        "tool_version",
        "generated_at",
        "inputs"
      ],
      "title": "ReportMeta",
      "type": "object"
    },
    "StageBench": {
      "additionalProperties": false,
      "description": "Throughput and latency for one camera (or 'ALL' for the pooled view).",
      "properties": {
        "camera_id": {
          "pattern": "^[A-Za-z0-9_.-]{1,64}$",
          "title": "Camera Id",
          "type": "string"
        },
        "n_records": {
          "minimum": 0,
          "title": "N Records",
          "type": "integer"
        },
        "n_dropped": {
          "minimum": 0,
          "title": "N Dropped",
          "type": "integer"
        },
        "n_processed": {
          "minimum": 0,
          "title": "N Processed",
          "type": "integer"
        },
        "drop_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Drop Rate",
          "type": "number"
        },
        "throughput_fps": {
          "minimum": 0.0,
          "title": "Throughput Fps",
          "type": "number"
        },
        "end_to_end": {
          "anyOf": [
            {
              "$ref": "#/$defs/LatencySummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "inference": {
          "anyOf": [
            {
              "$ref": "#/$defs/LatencySummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "queue_wait": {
          "anyOf": [
            {
              "$ref": "#/$defs/LatencySummary"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "camera_id",
        "n_records",
        "n_dropped",
        "n_processed",
        "drop_rate",
        "throughput_fps",
        "end_to_end",
        "inference",
        "queue_wait"
      ],
      "title": "StageBench",
      "type": "object"
    },
    "ThermalSummary": {
      "additionalProperties": false,
      "description": "CPU temperature over the benchmark window.",
      "properties": {
        "n_samples": {
          "minimum": 1,
          "title": "N Samples",
          "type": "integer"
        },
        "mean_temp_c": {
          "title": "Mean Temp C",
          "type": "number"
        },
        "max_temp_c": {
          "title": "Max Temp C",
          "type": "number"
        },
        "frac_at_or_above_throttle": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Frac At Or Above Throttle",
          "type": "number"
        }
      },
      "required": [
        "n_samples",
        "mean_temp_c",
        "max_temp_c",
        "frac_at_or_above_throttle"
      ],
      "title": "ThermalSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Accepted PIPELINE_BENCH artifact.",
  "properties": {
    "contract_id": {
      "const": "PipelineBenchReport",
      "default": "PipelineBenchReport",
      "title": "Contract Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "meta": {
      "$ref": "#/$defs/ReportMeta"
    },
    "percentile_method": {
      "const": "linear",
      "default": "linear",
      "title": "Percentile Method",
      "type": "string"
    },
    "warmup_s": {
      "minimum": 0.0,
      "title": "Warmup S",
      "type": "number"
    },
    "latency_budget_ms": {
      "exclusiveMinimum": 0.0,
      "title": "Latency Budget Ms",
      "type": "number"
    },
    "max_drop_rate": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Max Drop Rate",
      "type": "number"
    },
    "throttle_temp_c": {
      "title": "Throttle Temp C",
      "type": "number"
    },
    "cameras": {
      "items": {
        "$ref": "#/$defs/StageBench"
      },
      "minItems": 1,
      "title": "Cameras",
      "type": "array"
    },
    "overall": {
      "$ref": "#/$defs/StageBench"
    },
    "thermal": {
      "anyOf": [
        {
          "$ref": "#/$defs/ThermalSummary"
        },
        {
          "type": "null"
        }
      ]
    },
    "flags": {
      "items": {
        "enum": [
          "no_processed_frames",
          "latency_budget_exceeded",
          "drop_rate_high",
          "thermal_throttle_risk"
        ],
        "type": "string"
      },
      "title": "Flags",
      "type": "array"
    },
    "verdict": {
      "enum": [
        "PASS",
        "WARN",
        "FAIL"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "required": [
    "meta",
    "warmup_s",
    "latency_budget_ms",
    "max_drop_rate",
    "throttle_temp_c",
    "cameras",
    "overall",
    "thermal",
    "flags",
    "verdict"
  ],
  "title": "PipelineBenchReport",
  "type": "object"
}
