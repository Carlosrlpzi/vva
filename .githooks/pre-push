#!/bin/bash
# pre-push hook: runs the vva-audit agent on the commits about to be pushed.
#
# Reference copy. The active hook lives OUTSIDE the working tree, so a change here never
# runs until carlosr reviews and installs it:
#   install -D -m 0700 .githooks/pre-push ~/.config/vva/hooks/pre-push
#   git config core.hooksPath ~/.config/vva/hooks
#
# - Blocks the push when the auditor returns VERDICT: REQUEST_CHANGES, when the report has a
#   CRITICAL or HIGH finding (whatever the verdict), when the report has no parseable
#   VERDICT, when the audit itself fails, and on the ref rules below (fail closed).
# - Saves every report under .vva/audits/ (git-ignored).
# - Bypass deliberately with: git push --no-verify
# - Skip without bypassing other hooks: VVA_AUDIT=0 git push

set -euo pipefail

if [[ "${VVA_AUDIT:-1}" == "0" ]]; then
  echo "[vva-audit] skipped (VVA_AUDIT=0)" >&2
  exit 0
fi

# The auditor runs as the dedicated user "vva-audit" through a root-owned wrapper allowed
# by a narrow sudoers rule. It receives the pushed history as a git bundle on stdin and
# audits a fresh clone of it, never this working tree.
# -n: never prompt for a password; if sudo is not configured, fail (and block the push).
AUDIT_CMD=(sudo -n -u vva-audit /usr/local/bin/vva-audit-run)
ZERO_SHA="0000000000000000000000000000000000000000"
REPORT_DIR=".vva/audits"
mkdir -p "$REPORT_DIR"

status=0

# Git feeds one line per ref being pushed: <local ref> <local sha> <remote ref> <remote sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  # Deleting a remote branch: nothing to audit.
  [[ "$local_sha" == "$ZERO_SHA" ]] && continue

  # git bundle needs a ref. Pushing a bare SHA, or a ref that moved since git computed
  # local_sha, cannot be bundled faithfully: fail closed. The ref is compared WITHOUT
  # peeling: for an annotated tag local_sha is the tag object, not the commit.
  if [[ "$local_ref" != refs/* ]] \
     || [[ "$(git rev-parse --verify --quiet "$local_ref" || true)" != "$local_sha" ]]; then
    echo "[vva-audit] ${local_ref} is not a ref pointing at ${local_sha:0:8}. Push blocked." >&2
    status=1
    continue
  fi

  # The audit range is always commit..commit: peel tags. A ref that does not lead to a
  # commit (a tag of a tree or blob) has no history to audit: fail closed.
  if ! local_commit="$(git rev-parse --verify --quiet "${local_sha}^{commit}")"; then
    echo "[vva-audit] ${local_ref} does not point at a commit. Push blocked." >&2
    status=1
    continue
  fi

  # origin's default branch: the base for new refs, and the branch that never accepts a
  # non-fast-forward push. Unresolvable means we cannot apply either rule: fail closed.
  default_ref="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
  if [[ -z "$default_ref" ]]; then
    echo "[vva-audit] cannot resolve origin's default branch. Run: git remote set-head origin -a" >&2
    status=1
    continue
  fi

  if [[ "$remote_sha" == "$ZERO_SHA" ]]; then
    # New ref on the remote: audit commits not reachable from origin's default branch.
    # No fallback to the root commit: auditing the whole history exceeds the agent's
    # step budget and would only produce a report without a verdict.
    if ! base="$(git merge-base "$local_commit" "$default_ref")"; then
      echo "[vva-audit] no common ancestor with ${default_ref}. Push blocked." >&2
      status=1
      continue
    fi
  else
    # The remote tip must exist locally, otherwise rev-list fails with an unclear error.
    if ! remote_commit="$(git rev-parse --verify --quiet "${remote_sha}^{commit}")"; then
      echo "[vva-audit] remote commit ${remote_sha:0:8} not found locally. Run: git fetch" >&2
      status=1
      continue
    fi
    if git merge-base --is-ancestor "$remote_commit" "$local_commit"; then
      base="$remote_commit"
    else
      # Non-fast-forward (force) push, including a pure rewind. On the default branch it
      # would discard reviewed history (for example a security fix) without any audit of
      # what is lost, so it is always blocked; doing it on purpose needs VVA_AUDIT=0 or
      # --no-verify. Decision of the user, 2026-11-25.
      if [[ "$remote_ref" == "refs/heads/${default_ref#origin/}" ]]; then
        echo "[vva-audit] non-fast-forward push to the default branch ${remote_ref} is not allowed." \
          "Push blocked. If it is deliberate, push only that ref:" \
          "VVA_AUDIT=0 git push --force origin ${local_ref}:${remote_ref}" >&2
        status=1
        continue
      fi
      # Other branches: remote..local would name a base that is not in the bundle (the
      # wrapper would exit 10 with a misleading message). Audit what this push adds on top
      # of the common ancestor instead, and say so.
      if ! base="$(git merge-base "$remote_commit" "$local_commit")"; then
        echo "[vva-audit] force push to ${remote_ref} shares no history with the remote. Push blocked." >&2
        status=1
        continue
      fi
      echo "[vva-audit] force push to ${remote_ref}: remote commits after ${base:0:8} will be" \
        "discarded and are not audited; auditing only what this push adds (${base:0:8}..${local_commit:0:8})." >&2
    fi
  fi
  range="${base}..${local_commit}"

  # Nothing new in this ref (also a rewind of a non-default branch): say so, then skip.
  if [[ -z "$(git rev-list "$range")" ]]; then
    echo "[vva-audit] ${local_ref}: no new commits to audit (${range:0:8}..${local_commit:0:8})." >&2
    continue
  fi

  report="${REPORT_DIR}/$(date +%Y%m%d-%H%M%S)-${local_sha:0:8}.md"
  echo "[vva-audit] auditing ${range} -> ${report}" >&2

  # Non-interactive, static audit: the auditor's config denies running tests.
  # Ranges are passed as full SHAs so the wrapper can validate them strictly.
  # pipefail: a failed bundle or a failed audit both block the push.
  if ! git bundle create -q - "$local_ref" | "${AUDIT_CMD[@]}" "$range" > "$report"; then
    echo "[vva-audit] audit failed; see ${report} and the messages above. Push blocked." >&2
    status=1
    continue
  fi

  # Only the LAST non-empty line counts. A report that merely quotes a VERDICT line in its
  # body, or one cut off before the real verdict, must not pass (fail closed).
  verdict="$(grep -v '^[[:space:]]*$' "$report" | tail -n 1 | tr -d '\r' || true)"

  # The owner's merge rule (2026-11-25): nothing ships with an open CRITICAL or HIGH
  # finding, even under APPROVE_WITH_CHANGES. Findings start with "[SEVERITY] title" at the
  # beginning of a line (auditor prompt, section 5).
  blocking="$(grep -cE '^\[(CRITICAL|HIGH)\]' "$report" || true)"

  case "$verdict" in
    "VERDICT: APPROVE"|"VERDICT: APPROVE_WITH_CHANGES")
      if [[ "$blocking" != "0" ]]; then
        echo "[vva-audit] ${verdict} but ${blocking} CRITICAL/HIGH finding(s) (${local_ref})." \
          "Read ${report}. Push blocked." >&2
        status=1
      else
        echo "[vva-audit] ${verdict} (${local_ref})" >&2
      fi
      ;;
    "VERDICT: REQUEST_CHANGES")
      echo "[vva-audit] ${verdict} (${local_ref}). Read ${report}. Push blocked." >&2
      status=1
      ;;
    *)
      # Fail closed: a report without a parseable verdict is not an approval.
      echo "[vva-audit] no valid VERDICT line in ${report}. Push blocked." >&2
      status=1
      ;;
  esac
done

exit "$status"
