{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-opus-5-5",
  "small_model": "anthropic/claude-opus-5-5",
  "default_agent": "vva-audit",
  "share": "disabled",
  "autoupdate": false,
  "instructions": ["/etc/vva-audit/opencode/AGENTS.md"],
  "permission": {
    "*": "deny",
    "read": { "*": "allow", "*.env": "deny", "*.env.*": "deny", "*.env.example": "allow" },
    "external_directory": "deny",
    "doom_loop": "deny"
  },
  "agent": {
    "build": { "disable": true },
    "plan": { "disable": true },
    "vva-audit": {
      "description": "Claude Opus auditor: architectural review, code quality supervision, and cross-validation of DeepSeek changes. Read-only, never edits, never runs code.",
      "mode": "primary",
      "model": "anthropic/claude-opus-5-5",
      "prompt": "{file:/etc/vva-audit/opencode/prompts/vva-audit.md}",
      "steps": 30,
      "permission": {
        "*": "deny",
        "read": { "*": "allow", "*.env": "deny", "*.env.*": "deny", "*.env.example": "allow" },
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "bash": {
          "*": "deny",
          "git check-ignore*": "allow",
          "git ls-files*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git status*": "allow",
          "git *--no-index*": "deny",
          "git *--output*": "deny",
          "git *--ext-diff*": "deny",
          "git show*:*": "deny"
        },
        "edit": "deny",
        "task": "deny",
        "skill": "deny",
        "external_directory": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    }
  }
}
