#!/bin/bash
# /usr/local/bin/vva-review-bundle
#
# Deterministic first pass over a bundle delivered by the builder, run by carlosr inside the
# trusted repository (~/src/vva). It never runs code from the bundle and never merges.
#
#   vva-review-bundle /srv/vva-xfer/to-trusted/<name>.bundle [<base>]     (base: main)
#
# Install (root-owned, so the audited side cannot change what this check looks for):
#   sudo install -o root -g root -m 0755 install/vva-review-bundle /usr/local/bin/vva-review-bundle
#
# For every branch in the bundle it prints the commits and the diffstat against <base>, and
# lists any changed path that belongs to the owner or configures an agent:
#   - EXCLUDED_NAMES (any depth) and EXCLUDED_ROOT_NAMES (root only) of the INSTALLED
#     /usr/local/bin/vva-audit-run, read from that file so this list and the auditor's
#     exclusions cannot drift apart;
#   - the owner-only paths in OWNER_PATHS below, from the repository root.
# Refs that are not branches (tags, refs/stash) are listed, not imported: handle them by hand.
#
# Fails closed. Exit codes: 0 every branch is clean and there is nothing else in the bundle;
# 1 a protected path changed, or the bundle carries refs that are not branches (review by
# hand; not necessarily wrong); 2 usage or unknown base; 3 not run from a trusted checkout;
# 4 bundle invalid, without branches or with a branch name outside [A-Za-z0-9._/-], or a git
# command failed; 5 the protected names cannot be read from the installed wrapper. Any other
# code (bash/git killed) is also a failure.
# The bundle is copied once to a private directory (the mailbox belongs to the audited side,
# which could rewrite it between reads), bounded in time and size so a FIFO swapped in cannot
# hang the review or fill the disk; only the listed branches are fetched, one explicit
# refspec each, with --no-tags and fetch.fsckObjects; the base is resolved to a SHA from
# refs/heads/ before the fetch, so a smuggled refs/tags/main cannot move it.

set -euo pipefail

readonly WRAPPER="/usr/local/bin/vva-audit-run"
# Owner-only paths that are not agent-config names: changes here are drafted and committed
# by carlosr, never by the builder (docs/guia-opencode-ubuntu.md, "Rutina de trabajo").
# The root pytest config files (pyproject.toml, pytest.ini, tox.ini, setup.cfg) because they
# can change how pytest runs the owner's tests in the taller (plugins, addopts, -k).
readonly OWNER_PATHS=(tests/test_skills_consistency.py tests/test_audit_tools.py
  pyproject.toml pytest.ini tox.ini setup.cfg
  install .githooks docs/guia-opencode-ubuntu.md docs/security-decisions.md)
# Files that change how git shows content (`.gitattributes` with `-diff` hides a file's diff
# from the reviewer and the auditor), how it fetches (`.gitmodules`), or how pytest runs the
# tests (`conftest.py`: autouse fixtures, hooks), at any depth. Owner-only as well.
readonly GIT_META_NAMES=(.gitattributes .gitmodules conftest.py)
# Sanity check on what was read: the wrapper's list must at least protect these.
readonly REQUIRED_NAMES=(AGENTS.md opencode.json .opencode)
# Bounds for the private copy of the bundle. A full bundle of main is under 1 MiB today, so
# 256 MiB and 120 s leave a wide margin while still stopping a FIFO that never ends.
readonly COPY_TIMEOUT_S=120
readonly COPY_MAX_KIB=$((256 * 1024))

die() {
  local code="$1"
  shift
  echo "vva-review-bundle: $*" >&2
  exit "$code"
}

# Prints the words of the one-line bash array "readonly <var>=(...)" in <wrapper>, one per
# line. Fails (exit 5) if the line is missing or duplicated, or a word is not a plain file
# name. Called through a command substitution whose status the caller checks.
read_array() {
  # LC_ALL=C: the name check below must mean ASCII (see is_plain_branch_ref).
  local LC_ALL=C wrapper="$1" var="$2" line body word words=()
  [[ -f "$wrapper" && ! -L "$wrapper" ]] || die 5 "${wrapper} missing or a symlink"
  line="$(grep -E "^readonly ${var}=\(.*\)\$" "$wrapper" || true)"
  [[ -n "$line" && "$line" != *$'\n'* ]] || die 5 "exactly one 'readonly ${var}=(...)' line expected in ${wrapper}"
  body="${line#*\(}"
  body="${body%\)}"
  # read -a splits on whitespace without pathname expansion.
  read -r -a words <<< "$body"
  for word in "${words[@]}"; do
    [[ "$word" =~ ^[A-Za-z0-9._-]+$ ]] || die 5 "unexpected name in ${var}: ${word}"
    printf '%s\n' "$word"
  done
}

# Builds the pathspecs into the global array SPECS, failing closed if the wrapper's lists
# cannot be read or look wrong.
build_specs() {
  local wrapper="$1" raw name required found
  local -a names root_names
  raw="$(read_array "$wrapper" EXCLUDED_NAMES)" || exit $?
  mapfile -t names <<< "$raw"
  for required in "${REQUIRED_NAMES[@]}"; do
    found=0
    for name in "${names[@]}"; do
      if [[ "$name" == "$required" ]]; then
        found=1
      fi
    done
    ((found)) || die 5 "EXCLUDED_NAMES in ${wrapper} does not contain ${required}"
  done
  raw="$(read_array "$wrapper" EXCLUDED_ROOT_NAMES)" || exit $?
  mapfile -t root_names <<< "$raw"
  SPECS=()
  for name in "${names[@]}" "${GIT_META_NAMES[@]}"; do
    SPECS+=(":(top,glob)**/${name}" ":(top,glob)**/${name}/**")
  done
  for name in "${root_names[@]}" "${OWNER_PATHS[@]}"; do
    if [[ -n "$name" ]]; then
      SPECS+=(":(top)${name}")
    fi
  done
}

# Commit metadata is written by the builder: strip control characters before it reaches the
# terminal, so it cannot inject escape sequences. C0 and DEL (keeping tab and newline), and
# C1 controls U+0080-U+009F encoded in UTF-8 (0xC2 0x80-0x9F; e.g. CSI is U+009B).
sanitize() {
  LC_ALL=C tr -d '\000-\010\013-\037\177' | LC_ALL=C sed -e 's/\xc2[\x80-\x9f]//g'
}

# True if $1 is refs/heads/ followed only by ASCII letters, digits, '.', '_', '/', '-'.
# LC_ALL=C is required: in a UTF-8 locale the bracket range a-z also matches letters such
# as 'é', so the same regex would accept non-ASCII bytes.
is_plain_branch_ref() {
  local LC_ALL=C
  [[ "$1" =~ ^refs/heads/[A-Za-z0-9._/-]+$ ]]
}

# Copies <src> (in the mailbox, which the audited side controls) to <dst> (in our private
# 0700 directory), bounded in time and size, then checks the copy itself.
#   - The audited side can swap <src> after the caller's regular-file check. If it swaps in
#     a symlink, cp -P copies the symlink as a symlink and the check on <dst> rejects it.
#   - If it swaps in a FIFO, cp reads whatever is written to it: with no writer cp would
#     block forever, with an endless writer it would fill the disk. timeout and ulimit -f
#     (1 KiB blocks) stop both; the result is exit 4, never a hang.
#   - A FIFO that delivers a finite, valid bundle and closes yields a regular copy: that is
#     no different from the builder delivering that bundle, and only the copy is read.
# Exits 4 on any failure.
private_copy() {
  local src="$1" dst="$2" secs="$3" max_kib="$4"
  (
    ulimit -f "$max_kib"
    # Ignored SIGXFSZ: over the limit cp gets EFBIG and exits non-zero, instead of dying by
    # signal (which makes bash print a job-status line).
    trap '' XFSZ
    exec timeout --kill-after=5 "$secs" cp --no-dereference -- "$src" "$dst"
  ) 2>/dev/null || die 4 "could not copy the bundle within ${secs}s and ${max_kib} KiB" \
    "(replaced by a FIFO or special file, too large, or too slow)"
  [[ -f "$dst" && ! -L "$dst" ]] || die 4 "the bundle changed type while it was being copied"
}

# The whole review, with the wrapper path as a parameter so tests can pass a synthetic one.
review() {
  local wrapper="$1" bundle="${2:-}" base="${3:-main}"
  [[ -n "$bundle" && $# -le 3 ]] || die 2 "usage: vva-review-bundle <bundle> [<base>]"

  # Decide where we are BEFORE running any git command: git reads the repository's own
  # config and hooks, so it must never start inside a directory the audited side could
  # write (the taller, an old taller, a mailbox). Allowlist, not blocklist: the trusted
  # repository lives in the caller's home, which no other user can write.
  local here home top
  here="$(realpath -e -- "$PWD")" || die 3 "cannot resolve the current directory"
  home="$(realpath -e -- "$HOME")" || die 3 "cannot resolve HOME"
  [[ "$home" != "/" ]] || die 3 "HOME is /: refusing (run it as carlosr, not as root)"
  case "$here/" in
    "$home"/*) ;;
    *) die 3 "run it inside the trusted repository under ${home}, not in ${here}" ;;
  esac
  [[ -f "$bundle" && ! -L "$bundle" ]] || die 2 "${bundle} is not a regular file"
  top="$(git rev-parse --show-toplevel 2>/dev/null)" || die 3 "run it inside the trusted repository"
  case "$(realpath -e -- "$top")/" in
    "$home"/*) ;;
    *) die 3 "the repository root ${top} is outside ${home}" ;;
  esac
  # Resolve the base to a SHA once, from refs/heads/ explicitly (or a literal commit id),
  # BEFORE anything from the bundle reaches the repository: an unqualified name could later
  # resolve to a tag the builder smuggled in (refs/tags/main wins over refs/heads/main).
  local base_sha
  if base_sha="$(git rev-parse --verify --quiet "refs/heads/${base}^{commit}")"; then
    :
  elif [[ "$base" =~ ^[0-9a-f]{7,40}$ ]] && base_sha="$(git rev-parse --verify --quiet "${base}^{commit}")"; then
    :
  else
    die 2 "unknown base: ${base} (a local branch or a commit id)"
  fi

  build_specs "$wrapper"

  # The mailbox belongs to the audited side, which could rewrite the bundle between two
  # reads (TOCTOU). Copy it once into a private directory and read only the copy.
  local private
  private="$(mktemp -d)" || die 4 "cannot create a private directory"
  # shellcheck disable=SC2064  # expand now: $private is local
  trap "rm -rf -- '${private}'" EXIT
  private_copy "$bundle" "${private}/in.bundle" "$COPY_TIMEOUT_S" "$COPY_MAX_KIB"
  bundle="${private}/in.bundle"

  git bundle verify -q "$bundle" >/dev/null 2>&1 || die 4 "git bundle verify rejected the bundle"
  local heads
  heads="$(git bundle list-heads "$bundle")" || die 4 "cannot list the refs of the bundle"

  local -a branches=() others=() refspecs=()
  local ref
  while read -r _ ref; do
    [[ -n "$ref" ]] || continue
    if [[ "$ref" == refs/heads/* ]]; then
      # Branch names are printed and used as refspecs: plain ASCII only, so no escape
      # sequence (C1 controls survive git's own check-ref-format) and no refspec syntax.
      is_plain_branch_ref "$ref" \
        || die 4 "branch name with unexpected characters: $(printf '%s' "$ref" | sanitize)"
      branches+=("$ref")
      refspecs+=("+${ref}:refs/remotes/taller/${ref#refs/heads/}")
    else
      others+=("$ref")
    fi
  done <<< "$heads"
  ((${#branches[@]} > 0)) || die 4 "the bundle contains no branch (refs/heads/*)"

  # Remote-tracking refs only: nothing is checked out, merged or executed. One explicit
  # refspec per listed branch, so nothing unlisted is imported. --no-tags: a fetch with a
  # refspec would otherwise auto-follow the bundle's tags into refs/tags/. fsckObjects:
  # reject malformed objects.
  git -c fetch.fsckObjects=true fetch -q --no-tags "$bundle" "${refspecs[@]}" \
    || die 4 "git fetch from the bundle failed"

  local hits=0 head changed
  for ref in "${branches[@]}"; do
    head="refs/remotes/taller/${ref#refs/heads/}"
    echo "=== ${ref#refs/heads/}  (${base} ${base_sha:0:8}...${head#refs/remotes/})" | sanitize
    git log --format='%h %an %s' "${base_sha}..${head}" | sanitize || die 4 "git log failed"
    git diff --stat "${base_sha}...${head}" | sanitize || die 4 "git diff failed"
    changed="$(git diff --name-only "${base_sha}...${head}" -- "${SPECS[@]}")" || die 4 "git diff failed"
    if [[ -n "$changed" ]]; then
      echo "!!! protected paths changed (owner-only or agent config):"
      sed 's/^/    /' <<< "$changed" | sanitize
      hits=1
    else
      echo "ok: no protected path changed"
    fi
  done
  if ((${#others[@]} > 0)); then
    echo "!!! refs that are not branches were NOT imported (handle them by hand):"
    printf '    %s\n' "${others[@]}" | sanitize
    hits=1
  fi
  return "$hits"
}

# Run only when executed; tests/test_audit_tools.py sources this file to call review with a
# synthetic wrapper.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  review "$WRAPPER" "$@"
fi
