#!/bin/bash
# /usr/local/bin/vva-audit-run
#
# Runs the vva-audit agent as the dedicated user "vva-audit" on a fresh clone made from a
# git bundle of the trusted repository. Invoked by the pre-push hook through:
#   git bundle create - <ref> | sudo -n -u vva-audit /usr/local/bin/vva-audit-run <range>
#
# Install (root-owned, so neither carlosr, opencode-dev nor vva-audit can modify it):
#   sudo install -o root -g root -m 0755 vva-audit-run /usr/local/bin/vva-audit-run
#
# One-time root setup (directories root:root 0755, files root:root 0644 unless noted),
# copied from install/vva-audit/opencode/:
#   /etc/vva-audit/opencode/opencode.json            auditor-only OpenCode config
#   /etc/vva-audit/opencode/AGENTS.md                auditor's copy of the project rules
#   /etc/vva-audit/opencode/prompts/vva-audit.md     auditor prompt
#   /etc/vva-audit/opencode/commands/audit.md        /audit command
#   /etc/vva-audit/xdg/opencode                      empty; OpenCode mkdirs it at startup
#   /etc/vva-audit/anthropic.env                     root:vva-audit 0640, ANTHROPIC_API_KEY=<value>
#   /var/lib/vva-audit/work                          vva-audit:vva-audit 0700
# check_etc refuses to run if anything under /etc/vva-audit/{opencode,xdg} is a symlink,
# not a regular file or directory, not root-owned, or group/other-writable.
#
# Trust boundary: everything inside the audited repository is untrusted, including
# .opencode/, opencode.json, AGENTS.md and prompts/. OpenCode loads project config from
# the working directory up to the git root, and OPENCODE_CONFIG_DIR only adds on top of
# it, so the excluded paths are kept out of the checkout instead of being "overridden".
# The auditor's config, prompt and API key are installed by root under /etc/vva-audit/.
#
# Input: the bundle on stdin (no path to validate) and a strictly validated range.
#
# Exit codes (one per cause):
#   2  range is not <40-hex-sha>..<40-hex-sha>
#   3  API key file missing, unreadable or malformed
#   4  not running as vva-audit
#   5  opencode binary not found
#   6  opencode version differs from the pin
#   7  opencode binary path not root-owned or group/other-writable
#   8  /etc/vva-audit config or key file not root-owned or group/other-writable
#   9  bundle empty or invalid (rejected by git clone)
#   10 a SHA of the range is not in the bundle
#   11 an excluded path is present in the checkout
# Any other non-zero code comes from opencode itself.

set -euo pipefail

# Pinned version. The binary lives in a root-owned, versioned directory and cannot
# self-update there. Upgrade = install the reviewed binary under /opt/opencode/<new>/,
# change this value, reinstall this wrapper. Steps: docs/guia-opencode-ubuntu.md §6.1.
readonly OPENCODE_VERSION="1.19.5"
readonly OPENCODE_BIN_PINNED="/opt/opencode/${OPENCODE_VERSION}/opencode"

readonly AUDIT_USER="vva-audit"
readonly AUDIT_HOME="/var/lib/vva-audit"
readonly WORK_ROOT="${AUDIT_HOME}/work"
readonly ETC_DIR="/etc/vva-audit"
readonly CONFIG_DIR="${ETC_DIR}/opencode"
# Empty root-owned dir: OpenCode's "global" config path. AUDIT_HOME is owned by
# vva-audit, so a root-owned ~/.config/opencode inside it could still be renamed.
readonly XDG_DIR="${ETC_DIR}/xdg"
readonly KEY_FILE="${ETC_DIR}/anthropic.env"
readonly KEY_NAME="ANTHROPIC_API_KEY"
readonly SAFE_PATH="/usr/local/bin:/usr/bin:/bin"

# Names that must never reach OpenCode's config or instruction discovery, at ANY depth of
# the audited repo (a nested AGENTS.md or .opencode/ is as untrusted as a root one).
# CLAUDE.md and .claude/ because OpenCode also reads Claude-compatible instructions and
# skills; CONTEXT.md because it is a deprecated instruction file name; opencode.jsonc is
# the commented config variant; .agents/ as a precaution for skill discovery.
readonly EXCLUDED_NAMES=(AGENTS.md CLAUDE.md CONTEXT.md opencode.json opencode.jsonc .opencode .claude .agents prompts)

# Fixed PATH from the start: nothing below depends on the caller's PATH.
export PATH="$SAFE_PATH"

work=""
cleanup() {
  if [[ -n "$work" && -d "$work" ]]; then
    rm -rf -- "$work"
  fi
}
trap cleanup EXIT

die() {
  local code="$1"
  shift
  echo "vva-audit-run: $*" >&2
  exit "$code"
}

# Plain git with no system/global config and no hooks: the clone's own .git/config is
# freshly created by git clone, so nothing from the audited side can configure git.
safe_git() {
  # GIT_CEILING_DIRECTORIES: repository discovery never walks above the work root.
  GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_CEILING_DIRECTORIES="$WORK_ROOT" \
    git -c core.hooksPath=/dev/null "$@"
}

check_range() {
  if [[ ! "$1" =~ ^[0-9a-f]{40}\.\.[0-9a-f]{40}$ ]]; then
    die 2 "expected <40-hex-sha>..<40-hex-sha>, got: '$1'"
  fi
}

check_user() {
  if [[ "$(id -un)" != "$AUDIT_USER" ]]; then
    die 4 "must run as ${AUDIT_USER}"
  fi
}

# Walks from $2 up to / and fails with exit code $1 if any component is not
# root-owned or is group/other-writable. realpath first, so a symlink cannot point
# the check at one file and the later use at another.
check_root_path() {
  local code="$1" p owner mode
  p="$(realpath -e -- "$2")" || die "$code" "cannot resolve $2"
  while [[ "$p" != "/" ]]; do
    read -r owner mode < <(stat -c '%U %a' -- "$p")
    if [[ "$owner" != "root" ]] || (( 8#$mode & 8#022 )); then
      die "$code" "${p} must be root-owned and not group/other-writable (is ${owner} ${mode})"
    fi
    p="$(dirname -- "$p")"
  done
}

# Prints the resolved, checked opencode binary path.
resolve_opencode() {
  local bin installed
  [[ -x "$OPENCODE_BIN_PINNED" ]] || die 5 "opencode binary not found at ${OPENCODE_BIN_PINNED}"
  check_root_path 7 "$OPENCODE_BIN_PINNED"
  bin="$(realpath -e -- "$OPENCODE_BIN_PINNED")"
  installed="$("$bin" --version 2>/dev/null | tr -d '[:space:]' || true)"
  if [[ "$installed" != "$OPENCODE_VERSION" ]]; then
    echo "vva-audit-run: opencode ${installed:-unknown} installed, ${OPENCODE_VERSION} pinned." >&2
    die 6 "review the upgrade, then update OPENCODE_VERSION in install/vva-audit-run and reinstall."
  fi
  printf '%s\n' "$bin"
}

# Fails with exit code $1 if anything inside directory $2 (the directory included) is a
# symlink, is neither a regular file nor a directory, is not root-owned, or is
# group/other-writable. check_root_path covers the ancestors; this covers the contents,
# so a single writable prompt or config file cannot be swapped under a root-owned dir.
check_root_tree() {
  local code="$1" dir="$2" bad
  bad="$(find "$dir" \( -type l -o \( ! -type f ! -type d \) -o ! -user root -o -perm /022 \) \
    -print -quit)"
  if [[ -n "$bad" ]]; then
    die "$code" "${bad} must be a root-owned regular file or directory, not a symlink and not group/other-writable"
  fi
}

check_etc() {
  check_root_path 8 "$CONFIG_DIR"
  check_root_tree 8 "$CONFIG_DIR"
  check_root_path 8 "$XDG_DIR"
  check_root_tree 8 "$XDG_DIR"
  [[ -r "$KEY_FILE" ]] || die 3 "missing or unreadable ${KEY_FILE}"
  # realpath in check_root_path would follow a symlink; the key file must be the file itself.
  [[ ! -L "$KEY_FILE" ]] || die 8 "${KEY_FILE} must not be a symlink"
  check_root_path 8 "$KEY_FILE"
}

# Reads the key line by line, never with `source`: the file is data, not shell.
# Only KEY_NAME is accepted; the value is never printed.
read_key() {
  local line key=""
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    if [[ "$line" =~ ^${KEY_NAME}=([A-Za-z0-9_-]+)$ && -z "$key" ]]; then
      key="${BASH_REMATCH[1]}"
    else
      die 3 "${KEY_FILE}: unexpected line (only one ${KEY_NAME}=<value> is allowed)"
    fi
  done < "$KEY_FILE"
  [[ -n "$key" ]] || die 3 "${KEY_FILE}: ${KEY_NAME} not set"
  printf '%s' "$key"
}

# Copies the bundle from stdin into the work dir. Validity is checked by git clone:
# `git bundle verify` needs a repository (git 2.43) and the clone does not.
receive_bundle() {
  local bundle="$1"
  cat > "$bundle"
  [[ -s "$bundle" ]] || die 9 "empty bundle on stdin"
}

# Clones without checkout, checks both SHAs, then checks out the range's tip with the
# excluded paths left out by sparse-checkout (so `git status` stays clean).
clone_checkout() {
  local bundle="$1" repo="$2" base="$3" tip="$4" sha path
  safe_git clone -q --no-checkout "$bundle" "$repo" || die 9 "invalid bundle (git clone rejected it)"
  for sha in "$base" "$tip"; do
    safe_git -C "$repo" cat-file -e "${sha}^{commit}" 2>/dev/null \
      || die 10 "commit ${sha:0:8} not in bundle"
  done
  # Non-cone patterns follow .gitignore rules: a pattern without a slash (other than a
  # trailing one) matches at any depth, so "!AGENTS.md" also drops docs/x/AGENTS.md.
  local patterns=('/*') name
  for name in "${EXCLUDED_NAMES[@]}"; do
    patterns+=("!${name}" "!${name}/")
  done
  safe_git -C "$repo" sparse-checkout set --no-cone "${patterns[@]}"
  safe_git -C "$repo" checkout -q --detach "$tip"
  check_no_excluded "$repo"
}

# Defence in depth: whatever sparse-checkout did, no excluded name may exist anywhere in
# the checkout (file, directory or symlink). .git is skipped: it holds objects, not files
# OpenCode discovers.
check_no_excluded() {
  local repo="$1" name found
  local expr=()
  for name in "${EXCLUDED_NAMES[@]}"; do
    expr+=(-o -name "$name")
  done
  found="$(find "$repo" -path "${repo}/.git" -prune -o \( "${expr[@]:1}" \) -print -quit)"
  if [[ -n "$found" ]]; then
    die 11 "excluded path present in checkout: ${found#"${repo}"/}"
  fi
}

# Empties the environment (same effect as env -i) and exports only the allowlist.
# Not done with `env -i KEY=value cmd`: that would put the key in argv (/proc/<pid>/cmdline).
reset_env() {
  local key="$1" var
  while IFS= read -r var; do
    unset "$var"
  done < <(compgen -e)
  export HOME="$AUDIT_HOME"
  export PATH="$SAFE_PATH"
  export TMPDIR="$work"
  export XDG_CONFIG_HOME="$XDG_DIR"
  export OPENCODE_CONFIG_DIR="$CONFIG_DIR"
  # Also named as the config file, so loading it does not depend on whether this OpenCode
  # version reads opencode.json from OPENCODE_CONFIG_DIR. Loading it twice is idempotent.
  export OPENCODE_CONFIG="${CONFIG_DIR}/opencode.json"
  export GIT_CONFIG_NOSYSTEM=1
  export GIT_CONFIG_GLOBAL=/dev/null
  export LANG=C.UTF-8
  export "${KEY_NAME}=${key}"
}

main() {
  local range="${1:-}" bin key
  check_range "$range"
  check_user
  bin="$(resolve_opencode)"
  check_etc
  key="$(read_key)"

  umask 077
  work="$(mktemp -d "${WORK_ROOT}/run.XXXXXX")"
  # Leave the caller's cwd (e.g. carlosr's 750 repo): git must never look at it.
  cd "$work"
  receive_bundle "${work}/in.bundle"
  clone_checkout "${work}/in.bundle" "${work}/repo" "${range%%..*}" "${range##*..}"

  cd "${work}/repo"
  reset_env "$key"
  # Not exec: the EXIT trap must remove the work dir after opencode finishes.
  "$bin" run --agent vva-audit --command audit "$range" < /dev/null
}

main "$@"
