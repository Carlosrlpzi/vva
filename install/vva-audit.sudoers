# /etc/sudoers.d/vva-audit
# Lets carlosr run ONLY the audit wrapper as the dedicated user vva-audit, without a
# password. Replaces the old rule that pointed at opencode-dev (the audited user).
# Install with:
#   sudo install -o root -g root -m 0440 vva-audit.sudoers /etc/sudoers.d/vva-audit
#   sudo visudo -c
carlosr ALL=(vva-audit) NOPASSWD: /usr/local/bin/vva-audit-run
